PORT=3000
HOST=127.0.0.1
# PASTA_DADOS=C:/caminho/privado/dados-peregrina
# URL_PUBLICA=https://seu-dominio
# Em hospedagem HTTPS com um proxy confiável, configure CONFIAR_PROXY=1.
CONFIAR_PROXY=0
# Backups automáticos: padrão PASTA_DADOS/backups; use uma pasta privada e persistente.
# PASTA_BACKUPS=C:/Backups/Peregrina

# Backup externo privado, desativado por padrão. Configure apenas no servidor.
BACKUP_EXTERNO_ATIVO=0
# BACKUP_S3_ENDPOINT=https://endpoint-do-seu-armazenamento
# BACKUP_S3_BUCKET=nome-do-bucket-privado
# BACKUP_S3_REGIAO=auto
# BACKUP_S3_PREFIXO=peregrina
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_CHAVE_CRIPTOGRAFIA=chave-de-32-bytes-em-base64

# Recuperação de contas de clientes pela API Resend (configure um remetente autorizado).
# RESEND_API_KEY=
# EMAIL_REMETENTE=Gráfica Peregrina <contas@seu-dominio>
# URL_PUBLICA=https://seu-dominio
# Em produção: NODE_ENV=production (exige HTTPS e cookies Secure).

# Recuperação atual por código de 6 dígitos via Gmail.
# API Gmail por HTTPS com OAuth e permissão gmail.send (veja docs/recuperacao-senha.md).
# Nunca coloque estas variáveis no frontend.
# GMAIL_USUARIO=seuemail@gmail.com
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# Opcional: destinatário fixo do formulário. Se vazio, usa o e-mail comercial do painel;
# se o painel também estiver vazio, recebe na própria conta GMAIL_USUARIO.
# EMAIL_CONTATO=atendimento@seu-dominio
